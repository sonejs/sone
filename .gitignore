# Rust
/target/
**/target/

# Python binding
__pycache__/
*.pyc
*.so
*.pyd
.pytest_cache/
dist/
*.egg-info/

# C# binding build output. Scoped rather than a bare `bin/`, which would also
# swallow crates/sone-ffi/src/bin.
bindings/csharp/**/bin/
bindings/csharp/**/obj/

# Dart binding
bindings/dart/.dart_tool/
bindings/dart/pubspec.lock
bindings/dart/card.png

# JVM binding
bindings/jvm/target/
bindings/jvm/**/target/
hs_err_pid*.log
hs_err_pid*.mdmp
replay_pid*.log

# Swift binding. The XCFramework is a ~200 MB build artifact; make it with
# tools/build-apple.sh.
bindings/swift/.build/
bindings/swift/Sone.xcframework/

# Android and Flutter build output. The .so files come from
# tools/build-android.sh.
bindings/flutter/android/src/main/jniLibs/
bindings/flutter/**/.dart_tool/
bindings/flutter/**/build/
bindings/flutter/**/.gradle/
bindings/flutter/**/local.properties
bindings/flutter/**/*.iml
bindings/flutter/**/pubspec.lock

# Ruby binding
bindings/ruby/Gemfile.lock
bindings/ruby/pkg/

# Node / npm workspaces (the sone package lands in packages/)
node_modules/
*.tsbuildinfo

# Node binding build output. `binding.cjs`/`binding.d.ts` are generated by
# napi-rs from the `#[napi]` items, and the addon is per-platform.
bindings/node/*.node
bindings/node/binding.cjs
bindings/node/binding.d.ts
bindings/node/npm/

# WASM binding: the emscripten output, and the symlink farm build.sh creates to
# give Homebrew's emscripten the layout skia-bindings expects.
bindings/wasm/.emsdk/

# Written by `deno test`; the npm workspace lockfile is the source of truth.
deno.lock

# Local render output from `cargo run -p sone-goldens --bin render-all`
/target/renders/

.DS_Store
